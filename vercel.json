{
  "version": 2,
  "builds": [
    {
      "src": "snapcut-ai/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "snapcut-ai/dist"
      }
    },
    {
      "src": "snapcut-ai/server/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/snapcut-ai/$1"
    }
  ],
  "env": {
    "RAZORPAY_KEY_ID": "@razorpay_key_id",
    "RAZORPAY_KEY_SECRET": "@razorpay_key_secret",
    "REMOVE_BG_API_KEY": "@remove_bg_api_key"
  }
}