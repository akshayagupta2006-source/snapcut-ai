# Frontend Environment Variables (Public - Safe to expose in browser)
VITE_RAZORPAY_KEY_ID=rzp_test_SYcc6gZydQ5Yp7

# Backend API Base URL
# - For local development: http://localhost:3001
# - For production: Your deployed backend URL (e.g., https://your-backend.vercel.app)
# - This variable is used by the payment system to connect to the backend
VITE_API_BASE_URL=http://localhost:3001

# IMPORTANT SECURITY NOTE:
# - Only the public key ID (VITE_RAZORPAY_KEY_ID) should be in frontend .env
# - The secret key (RAZORPAY_KEY_SECRET) is securely stored in server/.env only
# - Never expose secret keys in frontend code or they will be visible to all users
# - VITE_API_BASE_URL should point to your secure backend (HTTPS in production)
